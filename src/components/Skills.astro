---
import { site } from "../data/site";
---

<!--
  SKILLS / TECH STACK SECTION
  - Displays your technologies as small tags/chips.
  - Edit the skills array in src/data/site.ts to add or remove.
-->
<section id="skills" class="max-w-4xl mx-auto px-6 py-20">
  <h2 class="text-2xl font-bold mb-6">Skills</h2>

  <!-- SKILL TAGS — each skill from site.skills becomes a tag -->
  <div class="flex flex-wrap gap-2">
    {site.skills.map((skill) => (
      <span class="bg-white border border-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg shadow-sm hover:border-accent-500 hover:text-accent-600 transition-colors">
        {skill}
      </span>
    ))}
  </div>
</section>
