---
import { site } from "../data/site";
---

<!-- HEADLINE — Your personal tagline -->
<section class="max-w-4xl mx-auto px-6 py-10">
  <h2 class="font-headline text-3xl sm:text-4xl font-bold leading-snug text-center max-w-2xl mx-auto">
    Real-World Systems Experience<br />Meets Modern Web Development
  </h2>

  <p class="mt-4 text-center text-sm font-sans text-ink-muted dark:text-night-ink-muted uppercase tracking-widest">
    By {site.name} &mdash; {site.role}
  </p>

  <div class="rule mt-8"></div>
</section>
